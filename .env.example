# ============================================================================
# Environment Configuration for Knife E-Commerce
# Copy this file to .env.local and fill in the values.
# ============================================================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/knife_ecommerce

# JWT
JWT_SECRET=your-32-character-minimum-secret

# Payment Signing
PAYMENT_SIGN_SECRET=your-payment-signing-secret

# Bank Account Details (server-side only, used in order emails)
BANK_ACCOUNT_NAME=Adam Cutlery
BANK_ACCOUNT_NUMBER=your-bank-account-number
BANK_NAME=HSBC
BANK_ADDRESS=

# Admin
ADMIN_PANEL_PIN=your-6-digit-pin
ADMIN_PIN_COOKIE_SECRET=your-32-character-minimum-secret
ADMIN_IP_WHITELIST=1.2.3.4,5.6.7.8

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
ORDER_RECEIVER_EMAIL=your-order-receiver@email.com

# Business Contact (public, used in footer and product inquiry)
NEXT_PUBLIC_BUSINESS_EMAIL=info@adamcutlery.com
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Adam Cutlery
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=your-bank-account-number
NEXT_PUBLIC_BANK_NAME=HSBC

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site
NEXT_PUBLIC_SITE_URL=https://adamcutlery.com
BUSINESS_EMAIL=info@adamcutlery.com
