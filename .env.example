# SMTP 配置：订单创建成功后自动发送到后台收件邮箱
# QQ 邮箱常用配置：
# 1. 登录 QQ 邮箱网页版
# 2. 设置 → 账号 → 开启 SMTP 服务
# 3. 生成“授权码”，填到 SMTP_PASS
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=填写QQ邮箱SMTP授权码
SMTP_FROM=
ORDER_RECEIVER_EMAIL=

# 私密收款信息：仅服务端读取，可选。不要写进前端页面。
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_ADDRESS=

# 登录 Cookie 签名密钥：生产环境必须设置为随机长字符串
JWT_SECRET=

# 可选短信服务 Webhook：配置后忘记密码会同时发送短信验证码
SMS_RECOVERY_WEBHOOK_URL=
SMS_RECOVERY_WEBHOOK_SECRET=
