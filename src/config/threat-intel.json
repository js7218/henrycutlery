  "waf_patterns": {
    "php_malicious": [
      "<\\?php\\s*\\$_(GET|POST|REQUEST|COOKIE|SERVER)\\s*\\[.*\\]\\s*\\(.*\\)",
      "<\\?php\\s*@?eval\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?assert\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?system\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?passthru\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?shell_exec\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?exec\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)\\s*\\[.*\\]\\s*\\)",
      "<\\?php\\s*@?eval\\s*\\(\\s*base64_decode\\s*\\(",
      "<\\?php\\s*@?eval\\s*\\(\\s*gzinflate\\s*\\(\\s*base64_decode\\s*\\(",
      "<\\?php\\s*@?eval\\s*\\(\\s*str_rot13\\s*\\(",
      "<\\?php\\s*@?eval\\s*\\(\\s*pack\\s*\\(",
      "eval\\s*\\(",
      "assert\\s*\\(",
      "system\\s*\\(",
      "exec\\s*\\(",
      "passthru\\s*\\(",
      "shell_exec\\s*\\(",
      "proc_open\\s*\\(",
      "popen\\s*\\(",
      "unserialize\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)"
    ],
    "image_trojan": [
      "<\\?php",
      "<\\?=",
      "GIF89a[\\s\\S]{0,100}<?",
      "PD9waHAg",
      "ZXZhbCAo"
    ],
    "command_execution": [
      "[;&|`$]\\s*(whoami|id|uname|hostname|ls|cat|echo|wget|curl|nc|netcat|bash|sh|cmd|powershell|python|perl|ruby|php)\\b",
      "bash\\s+-i\\s+>&?\\s*/dev/tcp",
      "cmd\\.exe\\s*/c",
      "powershell\\s+-nop\\s*-c\\s*['\"]",
      "/etc/passwd",
      "/etc/shadow"
    ],
    "sql_injection": [
      "\\b(SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|EXEC|EXECUTE)\\b",
      "\\b(UNION|UNION\\s+ALL|WAITFOR|DELAY)\\b",
      "union\\s+select",
      "\\b(sleep|benchmark|waitfor|pg_sleep)\\s*\\(",
      "or\\s+1\\s*=\\s*1",
      "and\\s+1\\s*=\\s*1",
      "information_schema",
      "load_file\\s*\\("
    ],
    "xss": [
      "<script",
      "<\\/script",
      "<img[^>]+onerror",
      "<iframe",
      "<embed",
      "<object",
      "<svg",
      "on\\w+\\s*=",
      "javascript\\s*:",
      "vbscript\\s*:",
      "expression\\s*\\("
    ],
    "path_traversal": [
      "\\.\\./",
      "%2e%2e",
      "\\.\\.\\\\",
      "php://input",
      "php://filter",
      "data://"
    ],
    "ssrf": [
      "127\\.\\d+\\.\\d+\\.\\d+",
      "10\\.\\d+\\.\\d+\\.\\d+",
      "172\\.(1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+",
      "192\\.168\\.\\d+\\.\\d+",
      "169\\.254\\.169\\.254",
      "localhost",
      "\\[::1\\]"
    ],
    "file_inclusion": [
      "\\?.*(file|path|dir|page|doc|view|include|require|open|read|load|template)=.*\\.\\.",
      "php://input",
      "php://filter",
      "data://text/plain",
      "expect://",
      "phar://"
    ],
    "malicious_redirect": [
      "javascript\\s*:",
      "vbscript\\s*:",
      "location\\.replace\\s*\\(",
      "window\\.location\\s*=",
      "document\\.location\\s*="
    ]
  },
  "security_headers": {
